// Typing along with you (render/gel/face.h), each on a frozen clock after a
// reset. Idle and your hands busy (the `typing` tag): its keyboard out, its
// paws tapping, its eyes down on the keys. You stop: the keyboard stays,
// its paws at rest; four seconds on it's gone. At work the tag changes
// nothing: its desk is the agents'. Asleep, nothing. A Moment takes the
// face at once, the keys gone under it.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"calm","vol":0,"idle":1,"when":["day","typing"]}
{"clock":1500}
{"shot":"typing"}
{"clock":1680}
{"shot":"typing-other-paw"}
{"t":"state","base":"idle","mood":"calm","vol":0,"idle":1,"when":["day"]}
{"clock":3000}
{"shot":"paused"}
{"clock":8000}
{"shot":"put-away"}
{"t":"state","base":"idle","mood":"calm","vol":0,"idle":1,"when":["day","typing"]}
{"clock":9000}
{"t":"do","name":"react","play":"now","args":{"mood":"happy","sign":"nice one"}}
{"clock":9600}
{"shot":"under-a-moment"}
