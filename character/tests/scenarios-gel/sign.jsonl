// A reaction's sign on the gel: a card held up in front of the body with
// a little gel hand at either side, from the reaction's start for as long
// as it plays and at least 2.5 s (render/gel/layers.h). Each on a frozen
// clock after a reset.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"happy","vol":0,"when":["day"]}
{"clock":1000}
{"t":"do","name":"react","play":"now","args":{"sign":"bye bye code"}}
{"expect":{"sign":"bye bye code"}}
{"clock":1600}
{"shot":"short"}
{"clock":3499}
{"expect":{"sign":"bye bye code"}}
{"clock":3500}
{"expect":{"sign":null}}
// The longest, 18 glyphs, over a finish and its trophy.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"happy","vol":0,"when":["day"]}
{"clock":1000}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","sign":"tests pass · ship!"}}
{"expect":{"moment":{"anim":"task_complete"},"sign":"tests pass · ship!"}}
{"clock":2800}
{"shot":"over-finish"}
// Growing a stage, as the Mac plays it: the confetti (a finish held twice
// with no turn) on the party day it starts, holding up what it grew into.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"working","mood":"happy","vol":0,"when":["day","party","sprout"]}
{"clock":1000}
{"t":"do","name":"task_complete","play":"now","args":{"outcome":"success","loops":2,"sign":"I'm a Sprout!"}}
{"expect":{"moment":{"anim":"task_complete","variant":5},"sign":"I'm a Sprout!"}}
{"clock":1800}
{"shot":"grew"}
{"clock":2600}
{"shot":"grew-confetti"}
// A special day's greeting: it wakes holding up the day's sign.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"working","mood":"happy","vol":0,"when":["day","halloween"]}
{"clock":1000}
{"t":"do","name":"wake_up","play":"now","args":{"sign":"Happy Halloween!"}}
{"expect":{"moment":{"anim":"wake_up"},"sign":"Happy Halloween!"}}
{"clock":2200}
{"shot":"greeting"}
// Something it remembers, held low in the lane, its face clear: the look, then
// the line for 5 s.
{"t":"dbg.reset"}
{"clock":0}
{"t":"state","base":"idle","mood":"calm","vol":0,"when":["evening"]}
{"clock":1000}
{"t":"do","name":"react","play":"now","args":{"sign":"u stay up late fridays","low":true,"clip":"remember","mood":"amused"}}
{"clock":1600}
{"shot":"remember-look"}
{"clock":3000}
{"shot":"remember-line"}
{"t":"do","name":"react","play":"now","args":{"sign":"you say morning buddy when you sit down","low":true,"clip":"remember","mood":"happy"}}
{"clock":4000}
{"shot":"remember-long"}
